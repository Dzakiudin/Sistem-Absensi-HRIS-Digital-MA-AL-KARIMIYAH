# Backend Environment

# Runtime
APP_ENV=local
PORT=8080
LOG_LEVEL=info

# JWT (wajib, minimal 32 karakter acak)
JWT_SECRET=change-me-to-a-very-long-random-secret-key-in-production
JWT_EXPIRY=24h

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/paspapan?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# HTTP server
RPC_TIMEOUT_SEC=15
HTTP_READ_TIMEOUT_SEC=30
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_IDLE_TIMEOUT_SEC=60

# Performance
HONOR_CACHE_SEC=60
SLOW_QUERY_MS=500

# pprof (jangan aktifkan di production)
APP_PPROF=false
PPROF_ADDR=127.0.0.1:6060
