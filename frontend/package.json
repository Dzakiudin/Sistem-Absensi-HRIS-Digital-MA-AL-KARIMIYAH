{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:app": "node scripts/build-app.mjs",
    "validate:html": "node scripts/validate-body-html.mjs",
    "check": "npm run build:app && npm run lint && npm run validate:html",
    "backend:build": "cd ../backend && go build -o app.exe .",
    "backend:test": "cd ../backend && go vet ./... && go test ./...",
    "backend:run": "node scripts/run-backend.cjs",
    "backend:restart": "npm run backend:build && npm run backend:run"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@stylexjs/stylex": "^0.19.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
