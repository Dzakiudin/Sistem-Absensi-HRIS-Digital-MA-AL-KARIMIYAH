# Salin jadi .env di root repo, lalu isi. JANGAN commit .env.
#   cp .env.example .env
#
# File ini hanya dipakai oleh docker compose. Konfigurasi backend yang lain
# sudah di-hardcode di docker-compose.yml.

# ---------------------------------------------------------------- database
POSTGRES_DB=paspapan
POSTGRES_USER=paspapan
# Wajib diganti. Buat sendiri, jangan pakai string contoh ini:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- aplikasi
# Domain untuk A record. Harus tanpa http:// dan tanpa garis miring.
DOMAIN=

# WAJIB diganti. Minimal 32 karakter acak:
#   openssl rand -hex 32
# JWT_SECRET=

JWT_EXPIRY=24h
LOG_LEVEL=info

# ---------------------------------------------------------------- runtime
# Connection pool. Default di config/ adalah 25/5.
# Kalau RAM >= 4GB, 20/5 masih aman dan memberi headroom saat rekap honor
# dan absensi datang bersamaan. Jangan lewat 25 kalau RAM masih 2GB.
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# ---------------------------------------------------------------- storage
# uid:gid untuk container backend. Harus sama dengan user `app` di
# backend/Dockerfile (default 10001). Kalau diganti, samakan juga adduser
# di Dockerfile. Jalankan juga: chown -R APP_UID:APP_GID backend/storage
APP_UID=10001
APP_GID=10001

# ---------------------------------------------------------------- backup
# Berapa lama file pg_dump disimpan di ./backups
BACKUP_RETENTION_DAYS=14
